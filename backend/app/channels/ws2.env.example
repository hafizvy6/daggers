# Daggers WS2 — environment switches (server-side only; never put keys in the extension).
# Everything below is OFF by default: with no variables set, WS2 runs fully offline on
# clearly labelled SYNTHETIC fixtures.

# --- Search channel
SEARCH_LIVE_ENABLED=0          # 1 = try Serper (if key) then DuckDuckGo before fixtures
# SERPER_API_KEY=              # optional; Google results via serper.dev

# --- Maps channel
MAPS_LIVE_ENABLED=0            # 1 + key = Google Places Text Search (authorized key required)
# GOOGLE_PLACES_API_KEY=

# --- Sweep API abuse controls
SWEEP_ALLOW_ARBITRARY=0        # 1 = accept free-text queries (still PII-filtered, 3–120 chars)
SWEEP_RATE_PER_MIN=6           # per client IP
SWEEP_MAX_CONCURRENT=2

# --- Guard
GUARD_MAX_AGE_DAYS=30          # MALICIOUS rows older than this are not blocked

# --- NextDNS push script (guard/sync_nextdns.py), operator machine only
# DAGGERS_API=http://localhost:8000
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE=
