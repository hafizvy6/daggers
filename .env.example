# Daggers · live-only environment template
# Copy to .env for local tooling. `make dev`/`make run` pass it to Uvicorn.
# There is no demo mode and no seed data: an empty database is a valid cold start.

APP_ENV=production
PORT=8000

# Explicit CORS origins (comma separated). Add your Cloudflare Pages origin in deployment.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost:8000,https://127.0.0.1:8000
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.pages\.dev$

# Paths (relative values resolve from the repository root). Persist these in production.
DB_PATH=backend/data/daggers.db
EVIDENCE_DIR=backend/data/evidence
GALLERY_DIR=backend/data/gallery
WEB_DIR=web

# Deterministic policy thresholds
MALICIOUS_THRESHOLD=0.65
SUSPICIOUS_THRESHOLD=0.35
RENDER_SCORE_MIN=0.45
AUTOFILE_CLONE_MIN=90
RADAR_MIN_DISPLAY_SCORE=0.35
GUARD_BLOCK_MISLEADING=0

# Auto-reporting is enabled as a policy, but reports only leave QUEUED to a
# real police intake when POLICE_INTAKE_ENABLED=1 and POLICE_INTAKE_URL is set.
# Until then, confirmations create zero-PII reports in the local portal queue.
AUTO_REPORT_ENABLED=1
POLICE_INTAKE_ENABLED=0
# POLICE_INTAKE_URL=https://intake.example.gov.ae/daggers
# POLICE_INTAKE_TOKEN=
POLICE_INTAKE_TIMEOUT_S=10

# -----------------------------------------------------------------------------
# LIVE ADAPTERS — all off by default. Disabled/unconfigured sources return honest
# empty states; no fixture, sample, or generated case is inserted.
# -----------------------------------------------------------------------------
CRT_ENABLED=0                  # crt.sh certificate-transparency poller
FEEDS_ENABLED=0                # OpenPhish + URLhaus, plus keyed PhishTank
ENRICH_ENABLED=0               # RDAP / DNS / TLS / favicon enrichment
RENDER_ENABLED=0               # Playwright capture + real evidence composition
SEARCH_LIVE_ENABLED=0          # Serper (if keyed) then DuckDuckGo HTML
MAPS_LIVE_ENABLED=0            # Maps channel; keyless OpenStreetMap when enabled, Google Places when keyed

# HTTP + polling
HTTP_TIMEOUT_S=10
RENDER_TIMEOUT_MS=15000
HTTP_USER_AGENT=Daggers-Research/1.0
CRT_MIN_QUERY_GAP_S=20
CRT_POLL_INTERVAL_S=60
FEED_POLL_INTERVAL_S=120
PIPELINE_POLL_INTERVAL_S=4
HEARTBEAT_INTERVAL_S=5

# Sweep API abuse controls. Typed searches are PII-filtered and rate-limited; set SWEEP_ALLOW_ARBITRARY=0 to restrict to canonical queries.
SWEEP_ALLOW_ARBITRARY=1         # free-text allowed (PII-filtered, rate-limited); set 0 for canonical-only when running a paid search key
SWEEP_RATE_PER_MIN=6
SWEEP_MAX_CONCURRENT=2
GUARD_MAX_AGE_DAYS=30

# -----------------------------------------------------------------------------
# AI Analyst — template output is deterministic and safe by default.
# Set AI_STATE=live AND provide a provider key to call an external model.
# Legacy AI_PROVIDER=gemini|groq|template and AI_ON=0 are still accepted.
# -----------------------------------------------------------------------------
AI_STATE=template
AI_PROVIDER=auto
AI_ON=1
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Server-side provider credentials. Never commit real values; never put keys in
# the browser, extension, service worker, or public web bundle.
# -----------------------------------------------------------------------------
# SERPER_API_KEY=
# GOOGLE_PLACES_API_KEY=
# PHISHTANK_KEY=
# GEMINI_KEY=
# GROQ_KEY=

# NextDNS: the app exposes only the DNS hostname to the PWA. `guard/sync_nextdns.py`
# reads the API key/profile on an operator machine for manual --apply syncs.
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE=
# NEXTDNS_DNS_HOSTNAME=
# DAGGERS_API=http://localhost:8000
