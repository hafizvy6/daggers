# Daggers WS1 — copy to .env only for local tooling; the app reads process env.
# Safe offline default. Judges can boot with no keys and no venue network.
MODE=demo
DEMO_MODE=1
PORT=8000

# Explicit CORS origins (comma separated). Add the Cloudflare Pages origin in deployment.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost:8000,https://127.0.0.1:8000
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.pages\.dev$

# Paths (relative values resolve from repository root)
DB_PATH=backend/data/daggers.db
EVIDENCE_DIR=backend/data/evidence
GALLERY_DIR=backend/data/gallery
SEED_DIR=backend/seed
WEB_DIR=web

# Deterministic policy thresholds
MALICIOUS_THRESHOLD=0.65
SUSPICIOUS_THRESHOLD=0.35
RENDER_SCORE_MIN=0.45
AUTOFILE_CLONE_MIN=90
GUARD_BLOCK_MISLEADING=0

# External adapters are opt-in. Fixtures keep every flow alive when disabled.
CRT_ENABLED=0
FEEDS_ENABLED=0
ENRICH_ENABLED=0
RENDER_ENABLED=0
HTTP_TIMEOUT_S=10
HTTP_USER_AGENT=Daggers-Research/1.0
CRT_MIN_QUERY_GAP_S=20

# Runtime cadence (seconds)
CRT_POLL_INTERVAL_S=60
FEED_POLL_INTERVAL_S=120
PIPELINE_POLL_INTERVAL_S=4
HEARTBEAT_INTERVAL_S=5

# WS3 sets this to ok when its AI chain is healthy; template is the honest fallback.
AI_STATE=template

# WS2 sweep/guard switches. Demo enables arbitrary hero queries; WS2 still
# applies PII filtering, length caps, rate limits, and fixture fallback.
SWEEP_ALLOW_ARBITRARY=1
SWEEP_RATE_PER_MIN=6
SWEEP_MAX_CONCURRENT=2
SEARCH_LIVE_ENABLED=0
MAPS_LIVE_ENABLED=0
GUARD_MAX_AGE_DAYS=30

# WS3 AI chain: auto uses only keys that are present, then template fallback.
AI_PROVIDER=auto
# AI_ON=0
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional keys owned by other lanes / external providers. Never commit real values.
# SERPER_API_KEY=
# GEMINI_KEY=
# GROQ_KEY=
# PHISHTANK_KEY=
# GOOGLE_PLACES_API_KEY=
# NEXTDNS_API_KEY=
# NEXTDNS_PROFILE=
