# Daggers — environment configuration. Copy to .env and edit. NEVER commit .env.
# Every switch has a safe default; no key is required to run.

# ---- environment: dev | production   (both are LIVE: there is no demo mode, seed or fixture data)
#  production: Secure cookies + HSTS, no API docs.
APP_ENV=dev
PORT=8000
DAGGERS_DOMAIN=daggers.example.org          # docker-compose/Caddy only

# ---- Police Portal security
COOKIE_SECURE=0             # forced to 1 when APP_ENV=production (HTTPS required)
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5        # per username and per client IP, 15-minute window
SCAN_RATE_PER_MIN=60        # public /api/check and /api/scan, per client IP per minute
# The Checker keeps its OWN result store (separate file, never the Police Portal database) and reuses a
# stored result for the same input while it is valid (same engine/policy/registry/reputation versions).
CHECKER_STORE_PATH=backend/data/checker-store.db
CHECK_CACHE_TTL_S=21600       # reuse a completed result for 6 h (0 = never reuse)
CHECK_CACHE_PARTIAL_TTL_S=600 # a result where some source could not be checked: 10 min
LOCAL_OPEN_ACCESS=0         # 1 = browsers on this same computer use the portal without signing in
                            #     (local admin; development only — ignored when APP_ENV=production)
TRUST_PROXY_HEADERS=0       # 1 only if a proxy you control sets X-Forwarded-For

# ---- CORS (public, credential-less endpoints only; the portal is same-origin)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.pages\.dev$

# ---- storage paths (relative to repo root)
DB_PATH=backend/data/daggers.db
EVIDENCE_DIR=backend/data/evidence
GALLERY_DIR=backend/data/gallery
OFFICIAL_REGISTRY_PATH=backend/app/channels/official/registry.yaml   # Docker: point at a copy in backend/data
OFFICIAL_SNAPSHOT_DIR=backend/data/official_snapshots   # records fetched by `make registry ARGS="fetch <id>"`
# ---- independent site reputation (SAFE for widely used, non-government sites; never "official")
REPUTATION_LIST_PATH=backend/data/reputation/top-sites.csv   # Tranco list, downloaded — none ships in the code
REPUTATION_AUTO_UPDATE=1      # download at start-up when missing or older than 7 days (needs network)
REPUTATION_TOP_N=60000        # only the top N worldwide domains count as reputable (etisalat.ae is ~#19,600)
REPUTATION_MAX_AGE_DAYS=45    # an older list is ignored (fail closed: nothing SAFE by reputation)
# ---- live Checker evidence (docs/CHECKER-ACCURACY.md)
CHECK_RDAP_ENABLED=1          # domain registration age via RDAP — only the registrable domain is sent
CHECK_PAGE_FETCH_ENABLED=1    # read-only retrieval of the checked link (markup only, private networks blocked)
CHECK_EVIDENCE_DEADLINE_S=10  # total time for live evidence per check (2–20 s)
CHECK_CT_ENABLED=1            # "HTTPS in use since" from Certificate Transparency (for .ae etc. without RDAP)
CT_API_URL=https://api.certspotter.com/v1/issuances
CT_API_KEY=                   # optional (SSLMate); without it the provider limits lookups per hour
WEB_DIR=web

# ---- intelligence engine thresholds
MALICIOUS_THRESHOLD=0.65
SUSPICIOUS_THRESHOLD=0.35
RENDER_SCORE_MIN=0.45
AUTOFILE_CLONE_MIN=90
GUARD_BLOCK_MISLEADING=0    # legacy alias of GUARD_INCLUDE_MISLEADING (see the Guard section)

# ---- radar / enrichment adapters (external network; all opt-in)
CRT_ENABLED=0
FEEDS_ENABLED=0
ENRICH_ENABLED=0
RENDER_ENABLED=0
HTTP_TIMEOUT_S=10
HTTP_USER_AGENT=Daggers-Research/1.0
CRT_MIN_QUERY_GAP_S=20
CRT_POLL_INTERVAL_S=60
FEED_POLL_INTERVAL_S=120
PIPELINE_POLL_INTERVAL_S=4
HEARTBEAT_INTERVAL_S=5

# ---- Search / Maps channels (server-side keys only)
SEARCH_LIVE_ENABLED=0
# SERPER_API_KEY=
MAPS_LIVE_ENABLED=0
# GOOGLE_PLACES_API_KEY=
SWEEP_ALLOW_ARBITRARY=0
SWEEP_RATE_PER_MIN=6
SWEEP_MAX_CONCURRENT=2

# ---- Guard (live list: only FAKE = confirmed MALICIOUS; never WARNING/UNKNOWN/official/shared)
GUARD_ENABLED=1
GUARD_MAX_AGE_DAYS=30
GUARD_INCLUDE_MISLEADING=0    # 1 = also list MISLEADING sites a government record CONTRADICTS
GUARD_SOURCES=radar,sweep,checker,investigation,seed   # which analyses may list a domain
GUARD_SYNC_DEBOUNCE_S=3       # new fakes in a burst → one provider sync
GUARD_SYNC_COOLDOWN_S=30      # manual "Sync now" cooldown
GUARD_PUBLIC_ORIGIN=          # e.g. https://daggers.example.org (else taken from the request)
# DNS-over-HTTPS on this server (RFC 8484, GET/POST /dns-query). Logs no client IPs or names.
GUARD_DOH_ENABLED=0
GUARD_UPSTREAM_DOH=https://cloudflare-dns.com/dns-query
GUARD_DOH_BLOCK_MODE=nxdomain # nxdomain | zero (0.0.0.0 / ::)
GUARD_DOH_RATE_PER_MIN=600
GUARD_VERDICT_IP=             # VPS only: blocked names answer this IP (nginx verdict server)
# NextDNS (Path A): the server pushes new fakes to the profile's denylist and reads analytics.
# NEVER commit real values.
NEXTDNS_PROFILE_ID=
NEXTDNS_API_KEY=
GUARD_DOT_HOSTNAME=           # optional override; default <profile>.dns.nextdns.io when a profile is set
PHISHTANK_KEY=               # optional threat-feed key (FEEDS_ENABLED=1)

# ---- AI Analyst (optional; template fallback is used when unset)
AI_PROVIDER=auto            # auto | gemini | groq | template
AI_ON=1
AI_STATE=template
# GEMINI_KEY=
# GROQ_KEY=
